{
  "buildCommand": "npm install && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|.*\\.(?:js|css|png|jpg|jpeg|gif|ico|svg|json|woff2?)).*)",
      "destination": "/index.html"
    }
  ]
}
